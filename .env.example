# Leave keys blank for offline source browsing. Never commit .env.
KESTREL_OFFLINE=1
KESTREL_LLM_API_KEY=
# Set these to a provider endpoint/model you can access before disabling offline mode.
KESTREL_LLM_BASE_URL=https://api.openai.com/v1
KESTREL_LLM_MODEL=
KESTREL_LLM_TIMEOUT=60
KESTREL_STRATEGY=hybrid
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kestrel-research-assistant
